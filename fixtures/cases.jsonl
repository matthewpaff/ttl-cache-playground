{"description": "distinguish cached null values from misses", "expected": {"keys": ["key-6"], "results": [{"evicted": null, "key": "key-6", "op": "put"}, {"hit": true, "key": "key-6", "op": "get", "value": null}], "time": 0}, "id": "cache-0006", "input": {"capacity": 2, "operations": [{"key": "key-6", "op": "put", "ttl": 3, "value": null}, {"key": "key-6", "op": "get"}]}}
{"description": "expire entries exactly at the TTL boundary", "expected": {"keys": [], "results": [{"evicted": null, "key": "key-7", "op": "put"}, {"op": "advance", "time": 2}, {"hit": false, "key": "key-7", "op": "get", "value": null}], "time": 2}, "id": "cache-0007", "input": {"capacity": 2, "operations": [{"key": "key-7", "op": "put", "ttl": 2, "value": 7}, {"op": "advance", "seconds": 2}, {"key": "key-7", "op": "get"}]}}
{"description": "retain entries before the TTL boundary", "expected": {"keys": ["key-8"], "results": [{"evicted": null, "key": "key-8", "op": "put"}, {"op": "advance", "time": 2}, {"hit": true, "key": "key-8", "op": "get", "value": 8}], "time": 2}, "id": "cache-0008", "input": {"capacity": 2, "operations": [{"key": "key-8", "op": "put", "ttl": 3, "value": 8}, {"op": "advance", "seconds": 2}, {"key": "key-8", "op": "get"}]}}
{"description": "evict the least recently read entry at capacity", "expected": {"keys": ["key-9-a", "key-9-c"], "results": [{"evicted": null, "key": "key-9-a", "op": "put"}, {"evicted": null, "key": "key-9-b", "op": "put"}, {"hit": true, "key": "key-9-a", "op": "get", "value": 1}, {"evicted": "key-9-b", "key": "key-9-c", "op": "put"}], "time": 0}, "id": "cache-0009", "input": {"capacity": 2, "operations": [{"key": "key-9-a", "op": "put", "ttl": 10, "value": 1}, {"key": "key-9-b", "op": "put", "ttl": 10, "value": 2}, {"key": "key-9-a", "op": "get"}, {"key": "key-9-c", "op": "put", "ttl": 10, "value": 3}]}}
{"description": "renew expiration when replacing a cached value", "expected": {"keys": ["key-10"], "results": [{"evicted": null, "key": "key-10", "op": "put"}, {"op": "advance", "time": 1}, {"evicted": null, "key": "key-10", "op": "put"}, {"op": "advance", "time": 2}, {"hit": true, "key": "key-10", "op": "get", "value": 11}], "time": 2}, "id": "cache-0010", "input": {"capacity": 2, "operations": [{"key": "key-10", "op": "put", "ttl": 2, "value": 10}, {"op": "advance", "seconds": 1}, {"key": "key-10", "op": "put", "ttl": 5, "value": 11}, {"op": "advance", "seconds": 1}, {"key": "key-10", "op": "get"}]}}
